{
  "routes": [
    {
      "src": "/api/submit-routes",
      "methods": ["POST"]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/if/(.*)",
      "destination": "/if"
    }
  ],
  "redirects": [
    { "source": "/", "destination": "/api", "permanent": false }
  ]
}
